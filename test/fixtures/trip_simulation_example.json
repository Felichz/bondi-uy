{
  "description": "Simulación de viaje completo: Caminar a parada -> Esperar bus -> Viajar en bus -> Caminar a destino",
  "phases": [
    {
      "type": "walkToStop",
      "duration": 15.0,
      "description": "Usuario camina hacia la parada de bus",
      "userPath": [
        { "lat": -34.9011, "lng": -56.1645 },
        { "lat": -34.9012, "lng": -56.1650 },
        { "lat": -34.9013, "lng": -56.1655 },
        { "lat": -34.9014, "lng": -56.1660 }
      ]
    },
    {
      "type": "waitForBus",
      "duration": 15.0,
      "description": "Usuario espera en parada mientras bus se acerca",
      "busEtaMinutes": 5,
      "userPath": [
        { "lat": -34.9014, "lng": -56.1660 }
      ],
      "busPath": [
        { "lat": -34.9100, "lng": -56.1700 },
        { "lat": -34.9080, "lng": -56.1680 },
        { "lat": -34.9060, "lng": -56.1670 },
        { "lat": -34.9040, "lng": -56.1665 },
        { "lat": -34.9020, "lng": -56.1662 },
        { "lat": -34.9014, "lng": -56.1660 }
      ]
    },
    {
      "type": "rideOnBus",
      "duration": 20.0,
      "description": "Usuario viaja en el bus",
      "userPath": [
        { "lat": -34.9014, "lng": -56.1660 },
        { "lat": -34.9020, "lng": -56.1650 },
        { "lat": -34.9030, "lng": -56.1640 },
        { "lat": -34.9040, "lng": -56.1630 },
        { "lat": -34.9050, "lng": -56.1620 }
      ],
      "busPath": [
        { "lat": -34.9014, "lng": -56.1660 },
        { "lat": -34.9020, "lng": -56.1650 },
        { "lat": -34.9030, "lng": -56.1640 },
        { "lat": -34.9040, "lng": -56.1630 },
        { "lat": -34.9050, "lng": -56.1620 }
      ]
    },
    {
      "type": "walkToDestination",
      "duration": 10.0,
      "description": "Usuario camina al destino final",
      "userPath": [
        { "lat": -34.9050, "lng": -56.1620 },
        { "lat": -34.9055, "lng": -56.1615 },
        { "lat": -34.9060, "lng": -56.1610 }
      ]
    }
  ],
  "config": {
    "speed": 1.0,
    "emitEvents": true,
    "expectedCameraEvents": [
      {
        "atTime": 1.0,
        "type": "zoomToUserAndStop",
        "description": "Cámara debe enfocar usuario y parada durante caminata",
        "expectedData": {
          "shouldInclude": ["user", "stop"],
          "shouldDrawBlueLine": true
        }
      },
      {
        "atTime": 16.0,
        "type": "zoomToBusAndStop",
        "description": "Cámara debe enfocar bus y parada durante espera",
        "expectedData": {
          "shouldInclude": ["bus", "stop"],
          "shouldDrawGreenLine": true,
          "shouldAdjustZoomOnBusUpdate": true
        }
      },
      {
        "atTime": 31.0,
        "type": "zoomToUserOnBus",
        "description": "Cámara debe enfocar usuario (en bus) y parada de destino",
        "expectedData": {
          "shouldInclude": ["user", "destinationStop"],
          "userShouldEqualBus": true
        }
      },
      {
        "atTime": 51.0,
        "type": "zoomToDestination",
        "description": "Cámara debe enfocar usuario y destino final",
        "expectedData": {
          "shouldInclude": ["user", "destination"],
          "shouldDrawBlueLine": true
        }
      }
    ]
  }
}
